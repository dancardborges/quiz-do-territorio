rules_version = '2';
// Regras de segurança do "APS em Jogo".
// Cole este texto inteiro em: Firebase → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Apresentador = quem entra com e-mail e senha cadastrados no Firebase.
    function isHost() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Quizzes: só a equipe (apresentadores) lê e edita.
    match /quizzes/{quizId} {
      allow read, write: if isHost();
    }

    match /games/{pin} {
      // Todo mundo pode ver o andamento do jogo (pergunta atual, placar).
      allow read: if true;
      allow create, update, delete: if isHost();

      // Jogadores: cada celular cria só o próprio cadastro.
      match /players/{uid} {
        allow read: if isHost() || (request.auth != null && request.auth.uid == uid);
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 24
          && (!('avatar' in request.resource.data) || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 16))
          && get(/databases/$(database)/documents/games/$(pin)).data.state != 'end';
        // Trocar só a figurinha, e só na sala de espera.
        allow update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar'])
          && request.resource.data.avatar is string
          && request.resource.data.avatar.size() <= 16
          && get(/databases/$(database)/documents/games/$(pin)).data.state == 'lobby';
        allow delete: if isHost();
      }

      // Reações: cada participante manda emojis que aparecem no telão (fora do tempo de resposta).
      match /reactions/{rid} {
        allow read, delete: if isHost();
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'e', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.e is string
          && request.resource.data.e.size() <= 8
          && exists(/databases/$(database)/documents/games/$(pin)/players/$(request.auth.uid))
          && get(/databases/$(database)/documents/games/$(pin)).data.state in ['lobby', 'reveal', 'board', 'end'];
      }

      // Respostas: uma por pessoa por pergunta, só enquanto o tempo está correndo.
      match /answers/{answerId} {
        allow read: if isHost();
        allow create: if request.auth != null
          && answerId == request.auth.uid + '_' + string(request.resource.data.q)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.choice is int
          && request.resource.data.choice >= 0
          && request.resource.data.choice < 4
          && exists(/databases/$(database)/documents/games/$(pin)/players/$(request.auth.uid))
          && get(/databases/$(database)/documents/games/$(pin)).data.state == 'question'
          && get(/databases/$(database)/documents/games/$(pin)).data.qIndex == request.resource.data.q;
        allow delete: if isHost();
      }
    }
  }
}
